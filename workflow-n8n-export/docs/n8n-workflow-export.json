        "jsCode": "// CÓDIGO DEFENSIVO: Verificar productos de nodo nativo\n// NOTA: Nodo nativo Pipedrive devuelve array de productos directamente\nconst allItems = $input.all();\n\nconsole.log('🔍 DEBUG - Get Products Response (nodo nativo):');\nconsole.log('Total items recibidos:', allItems.length);\n\nlet hasProducts = false;\n\nif (allItems && allItems.length > 0) {\n  // El nodo nativo con returnAll devuelve múltiples items\n  hasProducts = true;\n  console.log(`📊 Productos encontrados: ${allItems.length}`);\n} else {\n  console.log('📊 No se encontraron productos');\n}\n\nconsole.log(`✅ Tiene productos: ${hasProducts}`);\n\n// Retornar el primer producto con flag hasProducts\nif (hasProducts) {\n  return [{ json: { ...allItems[0].json, hasProducts: true } }];\n} else {\n  return [{ json: { hasProducts: false } }];\n}"
