    {
      "parameters": {
        "jsCode": "// CÓDIGO DEFENSIVO: Extraer product ID de manera defensiva\nconst productsResponse = $json;\nconst dealData = $('Extraer Deal ID').first().json;\n\nconsole.log('🔍 DEBUG - Extracting Product ID from:', JSON.stringify(productsResponse, null, 2));\n\nlet productId = null;\nconst productsData = productsResponse.data;\n\nif (Array.isArray(productsData) && productsData.length > 0) {\n  productId = productsData[0].id;\n  console.log('✅ Product ID extraído de array:', productId);\n} else if (productsData?.products && Array.isArray(productsData.products)) {\n  productId = productsData.products[0].id;\n  console.log('✅ Product ID extraído de nested products:', productId);\n} else if (productsData?.id) {\n  productId = productsData.id;\n  console.log('✅ Product ID extraído de objeto:', productId);\n}\n\nif (!productId) {\n  console.error('❌ No se pudo extraer product ID');\n  console.error('Estructura recibida:', JSON.stringify(productsResponse, null, 2));\n  throw new Error('Product ID not found in response');\n}\n\nconsole.log('✅ Product ID listo para actualizar:', productId);\n\nreturn [{\n  json: {\n    product_id: productId,\n    ...dealData\n  }\n}];"
      },
