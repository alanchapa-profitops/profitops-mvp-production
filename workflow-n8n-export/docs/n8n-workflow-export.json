    {
      "parameters": {
        "jsCode": "// Mapear tipos de actividad\nconst activityTypes = {\n  \"call\": \"call\",\n  \"meeting\": \"meeting\",\n  \"task\": \"task\",\n  \"deadline\": \"deadline\",\n  \"email\": \"email\",\n  \"lunch\": \"lunch\"\n};\n\nconst dealData = $('Extraer Deal ID').first().json;\nconst actividad = dealData.actividad;\nconst activityType = activityTypes[actividad.tipo] || \"task\";\n\nreturn [{\n  json: {\n    ...dealData,\n    activity_subject: actividad.titulo,\n    activity_type: activityType,\n    activity_due_date: actividad.fecha\n  }\n}];"
      },
